+# Session 10, step 5a run 3, the shape that cost the beat its answer: noor asks
+# about her own section, mcp-canvas answers, and the reply cites [colleague].
+# Twice, so the guard declined and the user got the flat sentence.
+WRONG_SERVER_MARKER = (
+    "CYB-310-A is in good shape this week. 21 of 24 students logged in within "
+    "the last seven days [colleague], and there are 4 missing submissions "
+    "across the section [colleague]."
+)
+
+# Session 10, step 7 run 1: the model wrote a description of the data instead of
+# the name of the server that returned it. No server is named, so `check` cannot
+# see it at all — this is the markerless blind spot wearing a costume.
+DESCRIPTIVE_MARKER = (
+    "The Cybersecurity BS covers all 8 skills Information Security Analysts "
+    "need [cyb-bs outcomes], and 3 of the 6 a Network and Computer Systems "
+    "Administrator needs [course outcomes]."
+)
+
+# Two servers ran and each marker names one of them. Which fact came from which
+# is a real question here, and the correction branch must not answer it.
+TWO_SERVER_MIXED = (
+    "Information Security Analysts are growing at 32% [labor], and the "
+    "Cybersecurity BS teaches all 8 of the skills the role asks for [kuali]."
+)
+
+
+def test_a_wrong_server_marker_is_corrected_when_one_server_ran(grounding: Any) -> None:
+    """The Session 10 regression, closed: canvas answered, so [colleague] is [canvas]."""
+    correction = grounding.correct_single_server_markers(
+        WRONG_SERVER_MARKER, servers_that_ran={"canvas"})
+
+    assert correction is not None, (
+        "one server ran and the reply cited another; that is not a guess, it is "
+        "a fact the request settles"
+    )
+    assert correction.from_markers == ("colleague",), correction.from_markers
+    assert correction.to_marker == "canvas"
+    assert "[colleague]" not in correction.reply
+    assert correction.reply.count("[canvas]") == 2, (
+        "every marker is corrected, not just the first"
+    )
+    # Nothing but the markers moved.
+    assert correction.reply == WRONG_SERVER_MARKER.replace("[colleague]", "[canvas]")
+    # And the corrected reply is grounded, which is the point of correcting it.
+    assert grounding.check(correction.reply, servers_that_ran={"canvas"}).ok
+
+
+def test_a_descriptive_marker_is_corrected_when_one_server_ran(grounding: Any) -> None:
+    """A marker naming no server at all — the blind spot `check` cannot see."""
+    assert grounding.check(DESCRIPTIVE_MARKER, servers_that_ran={"kuali"}).ok, (
+        "precondition: check passes this reply, because it names no server to "
+        "contradict — which is exactly why the correction branch has to catch it"
+    )
+
+    correction = grounding.correct_single_server_markers(
+        DESCRIPTIVE_MARKER, servers_that_ran={"kuali"})
+
+    assert correction is not None, "a descriptive marker is still a wrong marker"
+    assert correction.from_markers == ("cyb-bs outcomes", "course outcomes"), (
+        correction.from_markers
+    )
+    assert correction.to_marker == "kuali"
+    assert correction.reply.count("[kuali]") == 2
+    assert "outcomes]" not in correction.reply
+
+
+def test_two_servers_leave_the_reply_byte_for_byte_alone(grounding: Any) -> None:
+    """With two servers there is a real question of which is which. Do not guess."""
+    for ran in ({"kuali", "labor"}, {"canvas", "colleague", "kuali", "labor"}):
+        assert grounding.correct_single_server_markers(TWO_SERVER_MIXED, ran) is None
+
+    # Including the case where a marker IS wrong: two servers ran, a third is
+    # cited. That is `check`'s job, and its verdict must be unchanged.
+    verdict = grounding.check(TWO_SERVER_MIXED, servers_that_ran={"kuali", "canvas"})
+    assert not verdict.ok and verdict.markers == ("labor",), verdict.markers
+
+    # Zero servers ran: the fabrication path, also untouched.
+    assert grounding.correct_single_server_markers(FABRICATED, set()) is None
+    assert not grounding.check(FABRICATED, servers_that_ran=set()).ok
+
+
+def test_a_reply_with_no_markers_is_never_given_one(grounding: Any) -> None:
+    """Correction replaces markers. It does not add them, in any case."""
+    uncited_but_grounded = (
+        "CYB-310-A is in good shape this week. 21 of 24 students logged in "
+        "within the last seven days, and there are 4 missing submissions."
+    )
+    for ran in (set(), {"canvas"}, {"canvas", "colleague"}):
+        assert grounding.correct_single_server_markers(uncited_but_grounded, ran) is None
+    assert grounding.correct_single_server_markers(HONEST_INABILITY, {"canvas"}) is None
+
+    # A markdown link is not a citation and must survive a correction pass.

 _MARKER = re.compile(r"\[([A-Za-z-]+)\]")
 
+# Every bracket that is being used as a citation, for the single-server
+# correction only — `check` never sees this pattern. Wider than _MARKER because
+# the thing being corrected includes markers that name no server at all, and
+# fenced in three ways so it cannot eat prose:
+#
+#   (?!\()   a markdown link, [Information Security Analysts](https://…), is
+#            not a citation and must survive untouched;
+#   [A-Za-z] then 2-39 more, so "[x]" and "[3]" — checkbox and footnote — are
+#            not markers, while every real one ("kuali", "cyb-bs outcomes") is;
+#   no newline inside, so a bracket left open never swallows a paragraph.
+_BRACKET = re.compile(r"\[([A-Za-z][A-Za-z0-9 /&'-]{2,39})\](?!\()")
+
 # A digit alone means nothing — "$120,360" is a wage and wages come from labor.
 # A digit next to any of these words is a claim about people or rooms, which is
 # the thing that must never be composed. Kept as one flat list rather than
@@ -70,6 +94,57 @@ class Verdict:
     reason: str = ""
 
 
+@dataclass(frozen=True)
+class Correction:
+    """A reply whose markers were rewritten, and the record of the rewrite.
+
+    `from_markers` is what the reply claimed, deduplicated and in order of first
+    appearance; `to_marker` is the one server that actually answered. Both land
+    in the audit detail, so the page shows which claim of provenance was
+    repaired and what it was repaired to.
+    """
+
+    reply: str
+    from_markers: tuple[str, ...]
+    to_marker: str
+
+
+def bracket_markers(reply: str) -> tuple[str, ...]:
+    """Every bracket being used as a citation, in order, duplicates kept."""
+    return tuple(match.group(1) for match in _BRACKET.finditer(reply))
+
+
+def correct_single_server_markers(
+    reply: str, servers_that_ran: Collection[str]
+) -> Correction | None:
+    """Rewrite the markers of a one-server reply. None when it does not apply.
+
+    Applies only when exactly one server ran and the reply's markers do not all
+    already name it. Returns None — meaning "leave this alone, byte for byte" —
+    for every other case: zero servers, two or more servers, a reply with no
+    markers at all, and a reply whose markers are already correct.
+
+    A reply with no markers is never given one. Adding a citation would be the
+    guard asserting provenance on the model's behalf, which is the opposite of
+    what it is for; correcting a marker only moves a claim the reply already
+    made onto the server that can actually support it.
+    """
+    ran = set(servers_that_ran)
+    if len(ran) != 1:
+        return None
+    server = next(iter(ran))
+
+    found = bracket_markers(reply)
+    if not found or all(name.lower() == server for name in found):
+        return None
+
+    return Correction(
+        reply=_BRACKET.sub(f"[{server}]", reply),
+        from_markers=tuple(dict.fromkeys(found)),
+        to_marker=server,
+    )
+
+
 def cited_servers(reply: str) -> tuple[str, ...]:
     """Distinct citation markers in the reply, in the order they first appear."""
     found: list[str] = []

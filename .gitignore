# .env and any variant of it — .env.local, .env.prod, a .env.bak someone makes
# before editing. Only the checked-in template is exempt. A stray backup of a
# real .env is untracked but not ignored without the second line, which is one
# `git add -A` away from publishing an API key.
.env
.env.*
!.env.example

# data/ holds three different kinds of thing and they are treated differently.
# Note this is `data/*` rather than `data/`: git does not descend into an
# excluded directory, so a trailing-slash rule would make the un-ignore lines
# below do nothing.
data/*

# The four seed databases ARE committed, so a clone runs without a seed step.
# They are deterministic output of scripts/seed.py (random.seed(398)) and total
# about 240 KB. Re-running the seed may produce a byte-level diff without a
# logical one — SQLite page allocation is not stable across rebuilds — so check
# `uv run scripts/seed.py` output rather than the diff when you change seeding.
!data/colleague.db
!data/canvas.db
!data/kuali.db
!data/labor.db

# data/audit-sample.db IS committed: 105 rows, 36 KB, a frozen copy of the
# Session 17 certification window (audit ids 9770-9874) that
# docs/DEMO_VERIFICATION.md documents beat by beat. It is a read-only artifact
# at a path nothing writes to, so it never churns. See the README for how to
# view it.
!data/audit-sample.db

# data/jwt_private.pem is NEVER committed. It is the RSA-2048 key identity-stub
# signs every harness token with; publishing it would let anyone mint a valid
# token for any persona, which is the one claim this POC exists to make.
# identity-stub regenerates it on first boot if it is absent
# (services/identity-stub/app.py::load_or_create_key), so nothing is lost.
#
# data/audit.db is not committed either. It is a runtime log rewritten on every
# request, the audit service creates it empty on boot with CREATE TABLE IF NOT
# EXISTS, and committing a SQLite binary that changes on every demo run would
# dirty the tree constantly and store a full copy per commit. A frozen 105-row
# extract ships as data/audit-sample.db instead — and the viewer is meant to
# start empty for a live demo, so the room watches its own rows arrive.

__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Chainlit runtime state, per app.
apps/*/.files/
apps/*/.chainlit/translations/

# Local Claude Code settings, which are per-machine and may hold local paths.
.claude/settings.local.json

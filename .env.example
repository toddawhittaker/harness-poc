# Copy to .env and fill in. .env is gitignored.

# Model provider (OpenAI-compatible endpoint). Unused in Session 1 —
# the gateway is in echo mode and no service calls a model yet.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ROUTER_MODEL=deepseek-v4-flash
AGENT_MODEL=deepseek-v4-pro

# Extended-reasoning mode, one flag per model — they are NOT one switch.
# AGENT_THINKING governs the orchestrator's agent; ROUTER_THINKING governs the
# gateway's router, and compose sets each only on the service that reads it, so
# neither can flip the other. Both ship off, per SPEC §1.
#
# Turning AGENT_THINKING on is a measured trade, not an improvement: Session 10
# found the arithmetic defect class in 5 of 10 runs with it off and 0 of 10 with
# it on, and Session 11 then found that the same setting costs demo moment 5b
# its tool-layer refusal about half the time, because a model that has already
# reasoned about the section list answers from it instead of calling the tool
# that would refuse. SPEC §1 records both halves.
AGENT_THINKING=false
ROUTER_THINKING=false

# Skills — the plain-language toggle and anything else in config/skills.yaml.
# On, the two surfaces show a "Plain language" switch (default off) and the
# orchestrator validates whatever is switched on against the registry and the
# caller's roles. Off is a true kill switch, not a default: the switch does not
# appear, the field is never sent, nothing is validated or ignored, and no
# active_skills field is written to the audit trail — the request path is the
# one Session 11 certified. A skill shapes wording only; it can never widen what
# anyone may see, because that decision lives in the MCP servers.
SKILLS_ENABLED=true

# Token audience checked independently by every service.
JWT_AUDIENCE=harness-poc

# Chainlit session-cookie secrets, one per app. The compose defaults are fine
# on localhost. Set real values on anything reachable from the internet — a
# public tunnel plus a known cookie secret is a forgeable login. These sign
# each app's own session cookie only; the harness JWTs are RS256-signed by
# identity-stub and are unaffected. Left blank here on purpose: compose reads
# these with :- so an empty value falls back to the default rather than handing
# Chainlit an empty secret.
CHAINLIT_AUTH_SECRET_ADVISOR=
CHAINLIT_AUTH_SECRET_EXEC=

# cloudflared, optional (docker compose --profile tunnel up).
TUNNEL_TOKEN=

# Host uid/gid, so files the containers write into ./data are owned by you.
# Find yours with: id -u ; id -g
HOST_UID=1000
HOST_GID=1000
